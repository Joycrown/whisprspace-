export async function middleware(request: NextRequest) {
  // In development, if network issues occur, skip auth middleware
  // This prevents the app from being blocked by network errors
  // DISABLING SDK MIDDLEWARE temporarily/permanently as we migrate to raw-auth
  // Client-side protection (AuthProvider) will handle redirects.
  return NextResponse.next();
  
  /*
  if (process.env.NODE_ENV === 'development') {
    try {
